<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Tests for the parts of the plugin that do not need the game: the trainer engine, action
        matching, the opener library and the timeline layout maths. The sources are linked rather
        than referenced through the plugin assembly, so the tests run without Dalamud being loaded.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>OpenerTimeline.Tests</RootNamespace>
        <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\OpenerTimeline\Data\**\*.cs" Link="Plugin\Data\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\OpenerTimeline\Training\**\*.cs" Link="Plugin\Training\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\OpenerTimeline\Settings.cs" Link="Plugin\Settings.cs" />
        <Compile Include="..\OpenerTimeline\UI\Palette.cs" Link="Plugin\UI\Palette.cs" />
        <Compile Include="..\OpenerTimeline\UI\Appearance.cs" Link="Plugin\UI\Appearance.cs" />
        <Compile Include="..\OpenerTimeline\UI\Timeline\TimelineModels.cs" Link="Plugin\UI\Timeline\TimelineModels.cs" />
        <Compile Include="..\OpenerTimeline\UI\Timeline\TimelineLayout.cs" Link="Plugin\UI\Timeline\TimelineLayout.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Dalamud.Bindings.ImGui">
            <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
        </Reference>
        <Reference Include="HexaGen.Runtime">
            <HintPath>$(DalamudLibPath)HexaGen.Runtime.dll</HintPath>
        </Reference>
        <Reference Include="Lumina">
            <HintPath>$(DalamudLibPath)Lumina.dll</HintPath>
        </Reference>
        <Reference Include="Lumina.Excel">
            <HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Openers\openers.json" Link="openers.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
